{
    "name":  "portaria-prime",
    "private":  true,
    "version":  "0.0.0",
    "type":  "module",
    "scripts":  {
                    "dev":  "vite --port=3000 --host=0.0.0.0",
                    "dev:full":  "vercel dev --listen 3000",
                    "build":  "vite build",
                    "preview":  "vite preview",
                    "typecheck":  "tsc --noEmit \u0026\u0026 tsc -p tsconfig.api.json",
                    "lint":  "tsc --noEmit \u0026\u0026 tsc -p tsconfig.api.json",
                    "test":  "npm run test:db \u0026\u0026 npm run test:api",
                    "test:db":  "node --test tests/db/db.test.mjs tests/db/security-fixes.test.mjs tests/db/billing-authorization.test.mjs tests/db/restore.test.mjs",
                    "test:api":  "tsx --test tests/api/billing.test.mjs tests/api/push-security.test.mjs tests/api/http.test.mjs tests/tenant-loading.test.mjs",
                    "test:ui":  "node tests/ui-smoke.mjs",
                    "test:e2e":  "node --test tests/e2e/supabase-real.test.mjs",
                    "test:pwa":  "node tests/pwa-update.mjs"
                },
    "dependencies":  {
                         "@google/genai":  "^2.4.0",
                         "@supabase/supabase-js":  "^2.112.4",
                         "@tailwindcss/vite":  "^4.1.14",
                         "@vitejs/plugin-react":  "^5.0.4",
                         "jsqr":  "^1.4.0",
                         "lucide-react":  "^0.546.0",
                         "qrcode":  "^1.5.4",
                         "react":  "^19.0.1",
                         "react-dom":  "^19.0.1",
                         "vite":  "^6.2.3",
                         "web-push":  "^3.6.7"
                     },
    "devDependencies":  {
                            "@electric-sql/pglite":  "^0.5.10",
                            "@playwright/test":  "^1.64.1",
                            "@types/node":  "^22.14.0",
                            "@types/qrcode":  "^1.5.6",
                            "@types/react":  "^19.3.0",
                            "@types/react-dom":  "^19.3.0",
                            "@types/web-push":  "^3.6.4",
                            "autoprefixer":  "^10.4.21",
                            "esbuild":  "^0.25.0",
                            "tailwindcss":  "^4.1.14",
                            "tsx":  "^4.21.0",
                            "typescript":  "~5.8.2",
                            "vite":  "^6.2.3",
                            "vite-plugin-pwa":  "^1.3.0"
                        }
}
