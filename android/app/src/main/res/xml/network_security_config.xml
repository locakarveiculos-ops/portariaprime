<?xml version="1.0" encoding="utf-8"?>
<!-- Somente HTTPS com CAs do sistema (sem CAs do usuário, sem exceções de cleartext). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
